<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yuika.kanno-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/yuika/Library/Application Support/kanno-watch/kanno-watch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/kanno-watch.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/kanno-watch.out.log</string>
	<key>StartInterval</key>
	<integer>900</integer>
</dict>
</plist>
